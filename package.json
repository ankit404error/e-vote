{
  "name": "e-vote-system",
  "version": "1.0.0",
  "description": "Complete E-voting system with Aadhaar authentication and blockchain voting",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.js --network sepolia",
    "deploy-local": "npx hardhat run scripts/deploy.js --network localhost",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "build": "cd frontend && npm run build",
    "setup": "npm install && cd frontend && npm install",
    "install-all": "npm install && cd voting-backend && npm install && cd ../voting-frontend && npm install && cd ../frontend && npm install",
    "start-backend": "cd voting-backend && npm run dev",
    "start-frontend": "cd voting-frontend && npm start",
    "build-frontend": "cd voting-frontend && npm run build",
    "start-main-frontend": "cd frontend && npm run dev"
  },
  "keywords": ["e-voting", "aadhaar", "authentication", "fingerprint", "blockchain", "ethereum", "demo"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcrypt": "^5.1.0",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "web3": "^4.2.0",
    "@truffle/hdwallet-provider": "^2.1.15",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "hardhat": "^2.19.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0"
  }
}
