{
  "name": "e-vote-system",
  "version": "1.0.0",
  "description": "Complete E-voting system with Aadhaar authentication and blockchain voting",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy-sepolia.js --network sepolia",
    "deploy-local": "npx hardhat run scripts/deploy-secure.js --network localhost",
    "deploy-sepolia": "npx hardhat run scripts/deploy-sepolia.js --network sepolia",
    "test": "npx hardhat test",
    "test-sepolia": "npx hardhat test --network sepolia test/sepolia-integration.test.js",
    "node": "npx hardhat node",
    "network:status": "node scripts/network-switch.js status",
    "network:sepolia": "node scripts/network-switch.js sepolia",
    "network:local": "node scripts/network-switch.js localhost",
    "network:switch": "node scripts/network-switch.js",
    "blockchain:compile": "npx hardhat compile",
    "blockchain:deploy": "npm run deploy",
    "blockchain:test": "npm run test",
    "blockchain:verify": "npx hardhat verify --network sepolia",
    "blockchain:check": "node check-deployment.js",
    "test:voting-prevention": "node test-voting-prevention.js",
    "build": "cd frontend && npm run build",
    "setup": "npm install && cd frontend && npm install",
    "install-all": "npm install && cd voting-backend && npm install && cd ../voting-frontend && npm install && cd ../frontend && npm install",
    "start-backend": "cd voting-backend && npm run dev",
    "start-frontend": "cd voting-frontend && npm start",
    "build-frontend": "cd voting-frontend && npm run build",
    "start-main-frontend": "cd frontend && npm run dev",
    "voting-status": "node manage-voting.js status",
    "voting-enable": "node manage-voting.js enable",
    "voting-disable": "node manage-voting.js disable",
    "voting-config": "node manage-voting.js"
  },
  "keywords": [
    "e-voting",
    "aadhaar",
    "authentication",
    "fingerprint",
    "blockchain",
    "ethereum",
    "demo"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "node-fetch": "^2.7.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "web3": "^4.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "nodemon": "^3.0.1"
  }
}
